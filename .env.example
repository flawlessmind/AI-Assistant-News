ALFA_LLM_BASE_URL=https://changellenge.up.railway.app/v1
# Alternative official gateway (same key and budget): https://api.alfahack-gateway26.ru/v1
# key/info is requested only from the documented primary host, outside /v1.
ALFA_LLM_API_KEY=
ALFA_LLM_MODEL=deepseek/deepseek-v4.1-flash
# Explicit review stage model from the same six-model allowlist and the same gateway/budget.
ALFA_LLM_REVIEW_MODEL=google/gemma-4-26b-a4b-it
# One compact draft recovery after a length/reasoning-only failure; same gateway and shared budget.
ALFA_LLM_RECOVERY_MODEL=google/gemma-4-26b-a4b-it
ALFA_ALLOW_LIVE_LLM=false
ALFA_LLM_TIMEOUT_SECONDS=120
# Draft and review have independent output bounds (including reasoning if counted by the gateway).
ALFA_LLM_MAX_OUTPUT_TOKENS=8192
ALFA_LLM_REVIEW_MAX_TOKENS=6144
# 0 disables the application call-count cap; an optional positive value enables it.
# This does not remove the official gateway's shared 500 RUB daily budget.
# A new period starts at 03:00 Europe/Moscow, shared by all configured models.
ALFA_MAX_CALLS_PER_PERIOD=0
# Total queued + running jobs; identical active contexts are deduplicated first.
ALFA_MAX_ACTIVE_JOBS=16
# Local demo has no authentication. Remote binding needs explicit opt-in and external access controls.
ALFA_ALLOW_REMOTE_BIND=false
ALFA_AGENT_MAX_ROUNDS=2
# ALFA_RUNTIME_DIR=/app/var
# Default application search: local E5 embeddings plus BM25.
ALFA_SEARCH_MODE=hybrid
# Explicit host names accepted by the HTTP API; add a reverse proxy hostname when deploying.
ALFA_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Explicitly activate a separately validated bank corpus, then restart.
# ALFA_RESEARCH_DATABASE=/app/var/bank/2026-10-23/research.sqlite
# Only when the operator uses a managed HTTPS proxy; no private certificate is bundled.
# ALFA_NEWS_CA_BUNDLE=/path/to/operator-approved-ca.pem
